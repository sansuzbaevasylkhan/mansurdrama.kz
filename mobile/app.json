{
  "expo": {
    "name": "Mansur Drama",
    "slug": "mansurdrama-mobile",
    "version": "1.2.2.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mansurdrama",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/md.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a10"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kz.asylkhansansuzbaev.mansurdrama.app"
    },
    "android": {
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a10"
      },
      "package": "kz.asylkhansansuzbaev.mansurdrama.app",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-asset",
      "expo-image",
      "expo-status-bar",
      "expo-video",
      "expo-audio"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "apiBaseUrl": "https://mansurdrama-kz.vercel.app",
      "googleWebClientId": "",
      "googleAndroidClientId": "",
      "googleIosClientId": "",
      "eas": {
        "projectId": "3907d573-0c72-48af-ad39-7c21a7e97a71"
      }
    },
    "owner": "asylkhansansuzba454478645"
  }
}
