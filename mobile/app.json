{
  "expo": {
    "name": "Mansur Drama",
    "slug": "mansurdrama-mobile",
    "version": "1.2.1.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mansurdrama",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/md.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a10"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kz.asylkhansansuzbaev.mansurdrama.app"
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a10"
      },
      "package": "kz.asylkhansansuzbaev.mansurdrama.app",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-asset",
      "expo-image",
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "apiBaseUrl": "https://mansurdrama-kz.vercel.app",
      "googleWebClientId": "",
      "googleAndroidClientId": "",
      "googleIosClientId": "",
      "eas": {
        "projectId": "5d56a1aa-eb90-4289-a4c9-117d75d93bbf"
      }
    },
    "owner": "sansuzbaev856ghjk"
  }
}
