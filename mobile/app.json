
{
  "expo": {
    "name": "Mansur Drama",
    "slug": "mansurdrama-mobile",
    "version": "1.2.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mansurdrama",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kz.asylkhansansuzbaev.mansurdrama.app"
    },
    "android": {
      "versionCode": 12,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a10"
      },
      "package": "kz.asylkhansansuzbaev.mansurdrama.app",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/md.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a10"
        }
      ],
      "expo-router",
      "expo-web-browser",
      "expo-asset",
      "expo-image",
      "expo-status-bar",
      "expo-video",
      "expo-audio",
      "expo-font",
      [
        "@sentry/react-native",
        {
          "uploadSourceMaps": false
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "apiBaseUrl": "https://mansurdrama-kz.vercel.app",
      "googleWebClientId": "",
      "googleAndroidClientId": "",
      "googleIosClientId": "",
      "eas": {
        "projectId": "5d56a1aa-eb90-4289-a4c9-117d75d93bbf"
      }
    },
    "owner": "sansuzbaev856ghjk"
  }
}
