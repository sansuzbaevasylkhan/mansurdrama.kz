# ============================================
# Ескі кодтар (Pages Router) — app/ (App Router) қолданылады
# ============================================
# src/ каталогындағы ескі Pages Router стиліндегі кодтар.
# app/ — жаңа App Router. Екеуі қатар тұрса, Vercel build қате береді.
# Болашақта керек болса, .gitignore-дан алып тастаңыз.
/src/

# ============================================
# Backup / ескі кодтар
# ============================================
# src/app-backup — ескі App Router кодтары (Vercel build қате береді)
/src/app-backup/
