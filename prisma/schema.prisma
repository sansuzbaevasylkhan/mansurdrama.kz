// Local development schema (SQLite).
// Copy this file to schema.prisma when working locally:
//   cp prisma/schema.sqlite.prisma prisma/schema.prisma
// Then run: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Drama {
  id                String    @id @default(cuid())
  title             String
  slug              String    @unique
  description       String?
  posterUrl         String
  totalEpisodes     Int       @default(0)
  freeEpisodesCount Int       @default(0) // Тегін көрсетілетін сериялар саны
  views             Int       @default(0)
  rating            Float     @default(0)
  isPublished       Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  episodes        Episode[]
  payments        Payment[]
  unlockedContent UnlockedContent[]
  watchHistory    WatchHistory[]

  @@index([slug])
  @@index([createdAt])
  @@index([isPublished])
}

model Episode {
  id            String   @id @default(cuid())
  episodeNumber Int
  title         String
  videoUrl      String
  playbackId    String?
  muxAssetId    String?
  muxUploadId   String?
  duration      Int      @default(0)
  thumbnail     String?
  views         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  dramaId String
  drama   Drama @relation(fields: [dramaId], references: [id], onDelete: Cascade)

  watchHistory WatchHistory[]

  @@unique([dramaId, episodeNumber])
  @@index([dramaId])
}

model WatchHistory {
  id              String   @id @default(cuid())
  userId          String
  dramaId         String
  episodeId       String
  positionSeconds Int      @default(0)
  durationSeconds Int      @default(0)
  completed       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  drama   Drama   @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId, updatedAt])
  @@index([dramaId])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  avatar    String?
  banner    String?
  password  String   @default("")
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments       Payment[]
  unlockedContent UnlockedContent[]
  watchHistory    WatchHistory[]

  @@index([email])
  @@index([createdAt])
}

model Tariff {
  id          String   @id @default(cuid())
  name        String   // Мысалы: "Келесі серияны ашу" немесе "Толық пакет"
  price       Float
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments Payment[]
}

model Payment {
  id            String   @id @default(cuid())
  userId        String
  dramaId       String
  tariffId      String   // Қай тариф таңдалды
  type          String   // SINGLE_EPISODE | FULL_PACKAGE
  episodeNumber Int?
  receiptPdfUrl String   // PDF чек сілтемесі
  kaspiNumber   String
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  drama  Drama  @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  tariff Tariff @relation(fields: [tariffId], references: [id])

  @@index([status])
  @@index([userId])
  @@index([dramaId])
  @@index([createdAt])
}

model UnlockedContent {
  id            String   @id @default(cuid())
  userId        String
  dramaId       String
  episodeNumber Int?     // null = FULL_PACKAGE (барлық эпизодтар ашық)
  createdAt     DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  drama Drama @relation(fields: [dramaId], references: [id], onDelete: Cascade)

  @@unique([userId, dramaId, episodeNumber])
  @@index([userId])
  @@index([dramaId])
}
