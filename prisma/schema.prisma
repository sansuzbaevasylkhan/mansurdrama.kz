generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Drama {
  id                String            @id @default(cuid())
  title             String
  slug              String            @unique
  description       String?
  posterUrl         String
  totalEpisodes     Int               @default(0)
  freeEpisodesCount Int               @default(0)
  views             Int               @default(0)
  rating            Float             @default(0)
  isPublished       Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  episodes          Episode[]
  favorites         Favorite[]
  payments          Payment[]
  tariffDramas      TariffDrama[]
  unlockedContent   UnlockedContent[]
  watchHistory      WatchHistory[]
  watchProgress     WatchProgress[]

  @@index([slug])
  @@index([createdAt])
  @@index([isPublished])
}

model Episode {
  id            String          @id @default(cuid())
  episodeNumber Int
  title         String
  videoUrl      String
  playbackId    String?
  muxAssetId    String?
  muxUploadId   String?
  duration      Int             @default(0)
  thumbnail     String?
  views         Int             @default(0)
  status        EpisodeStatus   @default(PUBLISHED)
  publishAt     DateTime?
  publishedAt   DateTime?
  notifiedAt    DateTime?
  scheduledAt   DateTime?
  isPublished   Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  dramaId       String
  drama         Drama           @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  watchHistory  WatchHistory[]
  watchProgress WatchProgress[]

  @@unique([dramaId, episodeNumber])
  @@index([dramaId])
  @@index([status])
  @@index([status, publishAt])
}

model WatchHistory {
  id              String   @id @default(cuid())
  userId          String
  dramaId         String
  episodeId       String
  positionSeconds Int      @default(0)
  durationSeconds Int      @default(0)
  completed       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  drama           Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  episode         Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId, updatedAt])
  @@index([dramaId])
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  avatar              String?
  banner              String?
  passwordHash        String?
  role                String               @default("USER")
  notifyNewEpisodes   Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  freeEndedNotifiedAt DateTime?
  favorites           Favorite[]
  notifications       Notification[]
  settings            NotificationSetting?
  payments            Payment[]
  pushTokens          PushToken[]
  refunds             RefundRequest[]
  unlockedContent     UnlockedContent[]
  watchHistory        WatchHistory[]
  watchProgress       WatchProgress[]

  @@index([email])
  @@index([createdAt])
}

model RefundRequest {
  id               String       @id @default(cuid())
  paymentId        String       @unique
  userId           String
  reason           String
  status           RefundStatus @default(PENDING)
  adminComment     String?
  manuallyRefunded Boolean      @default(false)
  resolvedAt       DateTime?
  resolvedBy       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  payment          Payment      @relation(fields: [paymentId], references: [id])
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  payload   Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model PushToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  deviceType String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model NotificationSetting {
  userId      String  @id
  payments    Boolean @default(true)
  newEpisodes Boolean @default(true)
  promos      Boolean @default(true)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  userId  String
  dramaId String
  drama   Drama  @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, dramaId])
  @@index([userId])
  @@index([dramaId])
}

model WatchProgress {
  userId    String
  episodeId String
  dramaId   String
  seconds   Int      @default(0)
  updatedAt DateTime @updatedAt
  drama     Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, episodeId])
  @@index([userId])
  @@index([dramaId])
}

model AppConfig {
  id                      String   @id @default("singleton")
  latestVersion           String
  minimumSupportedVersion String
  forceUpdate             Boolean  @default(false)
  storeUrl                String
  message                 String?
  updatedAt               DateTime @updatedAt
}

model Tariff {
  id              String        @id @default(cuid())
  name            String
  price           Float
  discountPercent Int           @default(0)
  validUntil      DateTime?
  paymentPhone    String?
  description     String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  payments        Payment[]
  tariffDramas    TariffDrama[]
}

model Payment {
  id                   String         @id @default(cuid())
  userId               String
  dramaId              String
  tariffId             String
  type                 String
  episodeNumber        Int?
  receiptPdfUrl        String
  receiptHash          String?
  kaspiNumber          String
  amount               Int            @default(0)
  status               PaymentStatus  @default(PENDING)
  rejectReason         String?
  reviewedBy           String?
  reviewedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  isUpgraded           Boolean        @default(false)
  upgradeFromPaymentId String?
  drama                Drama          @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  tariff               Tariff         @relation(fields: [tariffId], references: [id])
  upgradedFrom         Payment?       @relation("PaymentUpgrade", fields: [upgradeFromPaymentId], references: [id])
  upgradedTo           Payment[]      @relation("PaymentUpgrade")
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refund               RefundRequest?

  @@index([status])
  @@index([userId])
  @@index([dramaId])
  @@index([createdAt])
}

model TariffDrama {
  tariffId String
  dramaId  String
  drama    Drama  @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  tariff   Tariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  @@id([tariffId, dramaId])
  @@index([dramaId])
}

model UnlockedContent {
  id            String   @id @default(cuid())
  userId        String
  dramaId       String
  episodeNumber Int?
  createdAt     DateTime @default(now())
  drama         Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dramaId, episodeNumber])
  @@index([userId])
  @@index([dramaId])
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EpisodeStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}
