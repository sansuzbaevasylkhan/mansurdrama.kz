# ============================================
# ENVIRONMENT VARIABLES (TEMPLATE)
# ============================================
# Бұл файл үлгі ретінде. Нақты мәндерді:
#  - Жергілікті: .env файлына (git-ке түспейді)
#  - Продакшн: Vercel Dashboard → Settings → Environment Variables
# ЕШҚАШАН нақты құпия сөздерді GitHub-қа push жасамаңыз!

# =========================================
# Database (Supabase — Recommended)
# =========================================
# Local dev:  DATABASE_URL="file:./dev.db"  (SQLite)
# Production: Supabase-тен алынған connection strings
#
# 1) Supabase Dashboard → Project Settings → Database
# 2) "Connection string" → "Transaction" (pooler) → DATABASE_URL
# 3) "Connection string" → "Direct" (5432)        → DIRECT_URL
#
# Формат мысалы:
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# =========================================
# Authentication
# =========================================
# Кемінде 32 таңбалы кездейсоқ жол — продакшнда міндетті!
ADMIN_PASSWORD="change-me"
JWT_SECRET="change-me-to-a-very-long-random-secret-at-least-32-chars"
NEXTAUTH_SECRET="change-me-to-a-very-long-random-secret-at-least-32-chars"

# =========================================
# Site
# =========================================
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Mansur Drama"

# =========================================
# Firebase (Client — браузерде көрінеді)
# =========================================
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://your-project-default-rtdb.firebaseio.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# =========================================
# Firebase Admin (Server — NEXT_PUBLIC_ қоймаңыз!)
# =========================================
# Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID="your-project"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
# Жаңа жол \n символдарымен — кодта replace жасалады
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Storage bucket (әдепкі — <projectId>.appspot.com)
FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
